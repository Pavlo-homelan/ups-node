#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"$UPS_PI_NODE_TEST_NMCLI_LOG"

if [[ "$*" == "-t -f DEVICE,STATE,CONNECTION dev status" ]]; then
    printf '%s:%s:%s\n' \
        "${UPS_PI_NODE_TEST_WIFI_INTERFACE:-wlan0}" \
        "${UPS_PI_NODE_TEST_WIFI_STATE:-disconnected}" \
        "${UPS_PI_NODE_TEST_WIFI_CONNECTION:---}"
    exit 0
fi

if [[ "$1 $2" == "connection show" ]]; then
    [[ "${UPS_PI_NODE_TEST_PROFILE_EXISTS:-1}" == "1" ]]
    exit
fi

exit 0
