# /etc/ups-pi-node/main.conf
# ups-pi-node power node configuration
# Copy this file to /etc/ups-pi-node/main.conf and adjust it for your hardware.

[ui]
# Interface language: uk | en
language = uk

[integrations]
# Stable node id used by Zabbix and Home Assistant payloads
node_id = ups-pi-node
# Optional API token for /api/integrations/*.
# Leave empty for local/plain metrics access.
token =

[load]
# Temporary load disconnect timeouts in seconds
timeout_1 = 30
timeout_2 = 300

[system]
# Unix socket for the privileged system helper
helper_socket = /run/ups-pi-node/helper.sock

[gpio]
# GPIO pins in BCM numbering
# Pins from the original working UPS controller
ac_detect_pin = 17
relay_1_pin = 27
relay_2_pin = 22
relay_3_pin = 25
relay_4_pin = 8
load_enable_pin = 7
gpiochip = /dev/gpiochip0

[wifi]
# Backend: mock | helper
backend = helper
interface = wlan0
hotspot_connection = ups-pi-node-hotspot
hotspot_ssid = Ups-Node
hotspot_password = 12345678
hotspot_address = 10.42.0.1
# Portal mode: auto | ap | client
portal_mode = auto

[ups]
# Backend: mock | ina3221
backend = ina3221
ac_sensor_pin = AC_DETECT
battery_empty_voltage = 9.3
battery_full_voltage = 12.6
i2c_bus = 1
i2c_address = 0x40
# INA3221 input channel used for the UPS shunt: 1 | 2 | 3
ina3221_channel = 1
# INA3221 channel used for the 19 V output shunt: 1 | 2 | 3
ina3221_output_channel = 2
# ADC averaging: 1 | 4 | 16 | 64 | 128 | 256 | 512 | 1024
ina3221_averaging = 16
# FL-2C 20 A / 75 mV nominal resistance: 0.075 V / 20 A = 0.00375 ohm
shunt_ohms = 0.00375
# Use -1 if the IN+/IN- sense wires are intentionally reversed.
current_polarity = 1
# Channel 2 uses the same FL-2C 20 A / 75 mV shunt.
output_shunt_ohms = 0.00375
# Use -1 if the Channel 2 IN+/IN- sense polarity is reversed.
output_current_polarity = 1
current_cutoff_ma = 150
current_noise_floor_ma = 30
low_voltage_shutdown_seconds = 20
control_interval = 1
switch_delay_seconds = 0.05

[display]
# ST7735 TFT from the verified controller. With rotate=1 these controller
# dimensions produce effective 128x160 portrait bounds on the installed panel.
enabled = true
spi_port = 0
spi_device = 0
dc_pin = 24
rst_pin = 25
width = 160
height = 128
rotate = 1
# TFT LED/BLK is wired to Raspberry Pi physical pin 12, BCM GPIO18.
backlight_pin = 18
# Leave 0 for luma defaults. Useful for debugging weak wiring/noisy SPI.
bus_speed_hz = 0

[auth]
# Auth mode: mock | env | pam
mode = pam
pam_service = ups-pi-node
