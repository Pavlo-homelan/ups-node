#!/usr/bin/env bash
set -euo pipefail

WIFI_IFACE="${UPS_PI_NODE_WIFI_INTERFACE:-wlan0}"
HOTSPOT_CONNECTION="${UPS_PI_NODE_HOTSPOT_CONNECTION_NAME:-ups-pi-node-hotspot}"
CONFIG_FILE="${UPS_PI_NODE_CONFIG_FILE:-/etc/ups-pi-node/main.conf}"
NMCLI="${UPS_PI_NODE_NMCLI:-$(command -v nmcli || true)}"

read_ini_value() {
    local file="$1"
    local section="$2"
    local key="$3"
    awk -F= -v section="$section" -v key="$key" '
        /^[[:space:]]*\[/ {
            current=$0
            gsub(/^[[:space:]]*\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            next
        }
        current == section {
            name=$1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            if (name == key) {
                value=$0
                sub(/^[^=]*=/, "", value)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                print value
                exit
            }
        }
    ' "$file" 2>/dev/null || true
}

CONFIG_HOTSPOT_SSID="$(read_ini_value "$CONFIG_FILE" wifi hotspot_ssid)"
CONFIG_HOTSPOT_PASSWORD="$(read_ini_value "$CONFIG_FILE" wifi hotspot_password)"
HOTSPOT_SSID="${CONFIG_HOTSPOT_SSID:-${UPS_PI_NODE_HOTSPOT_SSID:-Ups-Node}}"
HOTSPOT_PASSWORD="${CONFIG_HOTSPOT_PASSWORD:-${UPS_PI_NODE_HOTSPOT_PASSWORD:-12345678}}"

if [[ -z "$NMCLI" || ! -x "$NMCLI" ]]; then
    echo "nmcli is required for fallback hotspot management" >&2
    exit 1
fi

device_line="$("$NMCLI" -t -f DEVICE,STATE,CONNECTION dev status | awk -F: -v iface="$WIFI_IFACE" '$1 == iface {print; exit}')"
device_state="$(printf '%s' "$device_line" | cut -d: -f2)"
active_connection="$(printf '%s' "$device_line" | cut -d: -f3-)"

# An active client or hotspot connection is already the desired stable state.
# Re-activating the hotspot here disconnects every portal client on each timer
# tick. A connection attempt must also be allowed to finish without the
# fallback job racing it.
if [[ "$device_state" == "connected" || "$device_state" == "connecting" ]]; then
    exit 0
fi

if [[ "$device_state" != "disconnected" ]]; then
    echo "Wi-Fi interface '$WIFI_IFACE' is not ready for hotspot fallback (state: ${device_state:-unknown})" >&2
    exit 1
fi

if ! "$NMCLI" connection show "$HOTSPOT_CONNECTION" >/dev/null 2>&1; then
    "$NMCLI" connection add type wifi ifname "$WIFI_IFACE" con-name "$HOTSPOT_CONNECTION" autoconnect no ssid "$HOTSPOT_SSID"
fi

"$NMCLI" connection modify "$HOTSPOT_CONNECTION" \
    802-11-wireless.ssid "$HOTSPOT_SSID" \
    802-11-wireless.mode ap \
    802-11-wireless.band bg \
    ipv4.method shared \
    ipv6.method ignore \
    wifi-sec.key-mgmt wpa-psk \
    wifi-sec.psk "$HOTSPOT_PASSWORD"

"$NMCLI" connection up "$HOTSPOT_CONNECTION"
