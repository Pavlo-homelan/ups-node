[Unit]
Description=ups-pi-node Go system helper (hardware-disabled shadow)
Documentation=file:/usr/share/doc/ups-pi-node/go-migration.md
After=NetworkManager.service dbus.service
Wants=NetworkManager.service dbus.service

[Service]
Type=simple
User=root
Group=root
UMask=0007
RuntimeDirectory=ups-pi-node
RuntimeDirectoryMode=0755
ExecStart=/usr/lib/ups-pi-node/bin/ups-pi-node-helper-go --socket /run/ups-pi-node/go-helper.sock --socket-group www-data --config /etc/ups-pi-node/main.conf --hardware=false --pamtester /usr/bin/pamtester --pam-service ups-pi-node
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/ups-pi-node

[Install]
WantedBy=multi-user.target
