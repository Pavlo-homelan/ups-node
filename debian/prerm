#!/bin/bash
set -e
PATH=/usr/sbin:/usr/bin:/sbin:/bin

case "$1" in
    remove)
		deb-systemd-invoke stop ups-pi-node.service ups-pi-node-helper.service \
			ups-pi-node-web-go.service ups-pi-node-helper-go.service \
			ups-pi-node-helper-go-shadow.service ups-pi-node-hotspot-fallback.timer || true
		deb-systemd-helper disable ups-pi-node.service ups-pi-node-helper.service \
			ups-pi-node-web-go.service ups-pi-node-helper-go.service \
			ups-pi-node-helper-go-shadow.service ups-pi-node-hotspot-fallback.timer || true
        rm -f /etc/nginx/sites-enabled/ups-pi-node
		rm -f /etc/nginx/snippets/ups-pi-node-runtime.conf
		deb-systemd-invoke reload nginx.service || true
        ;;
esac

exit 0
