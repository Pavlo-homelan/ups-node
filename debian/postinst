#!/bin/bash
set -e
PATH=/usr/sbin:/usr/bin:/sbin:/bin

APP_DIR="/usr/lib/ups-pi-node"
VAR_DIR="/var/lib/ups-pi-node"
CONF_DIR="/etc/ups-pi-node"
ENV_FILE="/etc/default/ups-pi-node"
VENV_DIR="$VAR_DIR/.venv"
WIDGETS_DIR="$VAR_DIR/widgets"
DASHBOARD_WIDGETS_FILE="$VAR_DIR/dashboard-widgets.json"
RUNTIME_FILE="$CONF_DIR/runtime"

case "$1" in
    configure)
		# Do not execute or mutate the legacy virtualenv while ownership is
		# repaired. The selected helper is restored transactionally below.
		deb-systemd-invoke stop ups-pi-node.service ups-pi-node-web-go.service \
			ups-pi-node-helper.service ups-pi-node-helper-go.service \
			ups-pi-node-helper-go-shadow.service >/dev/null || true
        mkdir -p "$CONF_DIR"
		if [ -L "$WIDGETS_DIR" ]; then
			echo "Refusing symlink at $WIDGETS_DIR" >&2
			exit 1
		fi
        mkdir -p "$WIDGETS_DIR"

		if [ ! -f "$RUNTIME_FILE" ]; then
			old_umask="$(umask)"
			umask 022
			printf 'python\n' > "$RUNTIME_FILE"
			umask "$old_umask"
		fi
		chown root:root "$RUNTIME_FILE"
		chmod 644 "$RUNTIME_FILE"
		runtime_mode="$(tr -d '[:space:]' < "$RUNTIME_FILE")"
		case "$runtime_mode" in
			python|go) ;;
			*)
				echo "Invalid runtime in $RUNTIME_FILE: $runtime_mode" >&2
				exit 1
				;;
		esac

        if [ ! -f "$ENV_FILE" ]; then
            secret_key="$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')"
            old_umask="$(umask)"
            umask 077
            {
                printf 'UPS_PI_NODE_SECRET_KEY=%s\n' "$secret_key"
                printf 'UPS_PI_NODE_CONFIG_FILE=%s/main.conf\n' "$CONF_DIR"
                printf 'UPS_PI_NODE_WIDGETS_DIR=%s\n' "$WIDGETS_DIR"
                printf 'UPS_PI_NODE_DASHBOARD_WIDGETS_FILE=%s\n' "$DASHBOARD_WIDGETS_FILE"
                printf 'UPS_PI_NODE_HOTSPOT_SSID=Ups-Node\n'
                printf 'UPS_PI_NODE_HOTSPOT_PASSWORD=12345678\n'
            } > "$ENV_FILE"
            umask "$old_umask"
            chown root:www-data "$ENV_FILE"
            chmod 640 "$ENV_FILE"
            echo "Created environment file: $ENV_FILE"
        else
            if ! grep -q '^UPS_PI_NODE_HOTSPOT_SSID=' "$ENV_FILE"; then
                printf 'UPS_PI_NODE_HOTSPOT_SSID=Ups-Node\n' >> "$ENV_FILE"
            fi
            if ! grep -q '^UPS_PI_NODE_HOTSPOT_PASSWORD=' "$ENV_FILE"; then
                printf 'UPS_PI_NODE_HOTSPOT_PASSWORD=12345678\n' >> "$ENV_FILE"
            fi
        fi
		chown root:www-data "$ENV_FILE"
		chmod 640 "$ENV_FILE"

        if [ ! -f "$CONF_DIR/main.conf" ]; then
            cp "$CONF_DIR/main.conf.example" "$CONF_DIR/main.conf"
            chmod 660 "$CONF_DIR/main.conf"
            echo "Created config: $CONF_DIR/main.conf"
        else
            sed -i \
                -e 's/^\([[:space:]]*relay_1_pin[[:space:]]*=[[:space:]]*\)23[[:space:]]*$/\127/' \
                -e 's/^\([[:space:]]*relay_2_pin[[:space:]]*=[[:space:]]*\)24[[:space:]]*$/\122/' \
                -e 's/^\([[:space:]]*battery_empty_voltage[[:space:]]*=[[:space:]]*\)10\.8[[:space:]]*$/\19.3/' \
                -e 's/^\([[:space:]]*hotspot_ssid[[:space:]]*=[[:space:]]*\)ups-pi-node-setup[[:space:]]*$/\1Ups-Node/' \
                -e 's/^\([[:space:]]*backend[[:space:]]*=[[:space:]]*\)ina219[[:space:]]*$/\1ina3221/' \
                -e 's/^\([[:space:]]*shunt_ohms[[:space:]]*=[[:space:]]*\)0\.1[[:space:]]*$/\10.00375/' \
                -e 's/^\([[:space:]]*current_noise_floor_ma[[:space:]]*=[[:space:]]*\)5\([.]0\)\?[[:space:]]*$/\130/' \
                "$CONF_DIR/main.conf"
            if ! grep -q '^[[:space:]]*ina3221_channel[[:space:]]*=' "$CONF_DIR/main.conf"; then
                if grep -q '^\[ups\]' "$CONF_DIR/main.conf"; then
                    sed -i '/^\[ups\]/a ina3221_channel = 1' "$CONF_DIR/main.conf"
                else
                    printf '\n[ups]\nina3221_channel = 1\nshunt_ohms = 0.00375\ncurrent_polarity = 1\n' >> "$CONF_DIR/main.conf"
                fi
            fi
            if ! grep -q '^[[:space:]]*ina3221_output_channel[[:space:]]*=' "$CONF_DIR/main.conf"; then
                sed -i '/^\[ups\]/a ina3221_output_channel = 2' "$CONF_DIR/main.conf"
            fi
            if ! grep -q '^[[:space:]]*shunt_ohms[[:space:]]*=' "$CONF_DIR/main.conf"; then
                sed -i '/^\[ups\]/a shunt_ohms = 0.00375' "$CONF_DIR/main.conf"
            fi
            if ! grep -q '^[[:space:]]*current_polarity[[:space:]]*=' "$CONF_DIR/main.conf"; then
                sed -i '/^\[ups\]/a current_polarity = 1' "$CONF_DIR/main.conf"
            fi
            if ! grep -q '^[[:space:]]*output_shunt_ohms[[:space:]]*=' "$CONF_DIR/main.conf"; then
                sed -i '/^\[ups\]/a output_shunt_ohms = 0.00375' "$CONF_DIR/main.conf"
            fi
            if ! grep -q '^[[:space:]]*output_current_polarity[[:space:]]*=' "$CONF_DIR/main.conf"; then
                sed -i '/^\[ups\]/a output_current_polarity = 1' "$CONF_DIR/main.conf"
            fi
            if ! grep -q '^[[:space:]]*ina3221_averaging[[:space:]]*=' "$CONF_DIR/main.conf"; then
                sed -i '/^\[ups\]/a ina3221_averaging = 16' "$CONF_DIR/main.conf"
            fi
            if ! grep -q '^[[:space:]]*hotspot_password[[:space:]]*=' "$CONF_DIR/main.conf"; then
                if grep -q '^\[wifi\]' "$CONF_DIR/main.conf"; then
                    sed -i '/^\[wifi\]/a hotspot_password = 12345678' "$CONF_DIR/main.conf"
                else
                    printf '\n[wifi]\nhotspot_password = 12345678\n' >> "$CONF_DIR/main.conf"
                fi
            fi
            if ! grep -q '^[[:space:]]*ipv6[[:space:]]*=' "$CONF_DIR/main.conf"; then
                if grep -q '^\[wifi\]' "$CONF_DIR/main.conf"; then
                    sed -i '/^\[wifi\]/a ipv6 = disabled' "$CONF_DIR/main.conf"
                else
                    printf '\n[wifi]\nipv6 = disabled\n' >> "$CONF_DIR/main.conf"
                fi
            fi
            if ! grep -q '^[[:space:]]*pam_service[[:space:]]*=' "$CONF_DIR/main.conf"; then
                if grep -q '^\[auth\]' "$CONF_DIR/main.conf"; then
                    sed -i '/^\[auth\]/a pam_service = ups-pi-node' "$CONF_DIR/main.conf"
                else
                    printf '\n[auth]\npam_service = ups-pi-node\n' >> "$CONF_DIR/main.conf"
                fi
            fi
            if ! grep -q '^\[display\]' "$CONF_DIR/main.conf"; then
                cat >> "$CONF_DIR/main.conf" <<'EOF'

[display]
enabled = true
spi_port = 0
spi_device = 0
dc_pin = 24
rst_pin = 25
width = 160
height = 128
rotate = 1
backlight_pin = 18
bus_speed_hz = 0
EOF
            else
                if ! grep -q '^[[:space:]]*backlight_pin[[:space:]]*=' "$CONF_DIR/main.conf"; then
                    sed -i '/^\[display\]/a backlight_pin = 18' "$CONF_DIR/main.conf"
                fi
                if ! grep -q '^[[:space:]]*bus_speed_hz[[:space:]]*=' "$CONF_DIR/main.conf"; then
                    sed -i '/^\[display\]/a bus_speed_hz = 0' "$CONF_DIR/main.conf"
                fi
            fi
        fi

		if [ -L "$VENV_DIR" ] || { [ -e "$VENV_DIR" ] && [ ! -d "$VENV_DIR" ]; }; then
			echo "Refusing unsafe virtualenv path: $VENV_DIR" >&2
			exit 1
		fi
		if [ -d "$VENV_DIR" ] && [ -n "$(find "$VENV_DIR" -xdev \( -type f -o -type d \) \( ! -user root -o -perm /022 \) -print -quit)" ]; then
			venv_backup="$VAR_DIR/.venv.pre-0.3.0"
			if [ -e "$venv_backup" ] || [ -L "$venv_backup" ]; then
				echo "Cannot quarantine writable virtualenv: $venv_backup already exists" >&2
				exit 1
			fi
			mv "$VENV_DIR" "$venv_backup"
			chown -R root:root "$venv_backup"
			chmod -R go-rwx "$venv_backup"
			echo "Quarantined web-writable virtualenv: $venv_backup"
		fi

        if [ ! -d "$VENV_DIR" ]; then
            python3 -m venv "$VENV_DIR"
        elif [ -f "$VENV_DIR/pyvenv.cfg" ]; then
            if grep -q '^include-system-site-packages = ' "$VENV_DIR/pyvenv.cfg"; then
                sed -i 's/^include-system-site-packages = .*/include-system-site-packages = false/' "$VENV_DIR/pyvenv.cfg"
            else
                printf '\ninclude-system-site-packages = false\n' >> "$VENV_DIR/pyvenv.cfg"
            fi
        fi

        venv_site="$("$VENV_DIR/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
        if [ -d /usr/lib/python3/dist-packages ]; then
            printf '/usr/lib/python3/dist-packages\n' > "$venv_site/ups_pi_node_debian_dist_packages.pth"
        fi
        if [ "${UPS_PI_NODE_INSTALL_PIP_REQUIREMENTS:-0}" = "1" ]; then
            "$VENV_DIR/bin/pip" install --quiet --no-index -r "$APP_DIR/requirements.txt"
        else
            "$VENV_DIR/bin/python" -c 'import flask, gunicorn' >/dev/null
        fi

		# The root helper executes this interpreter. Never let the web account
		# replace packages or the interpreter inside the virtualenv.
		chown -R root:root "$VENV_DIR"
		chmod -R go-w "$VENV_DIR"
		chown root:www-data "$VAR_DIR"
		chmod 1770 "$VAR_DIR"
		chown -R www-data:www-data "$WIDGETS_DIR"
		chmod 750 "$WIDGETS_DIR"
		if [ -L "$DASHBOARD_WIDGETS_FILE" ]; then
			echo "Refusing symlink at $DASHBOARD_WIDGETS_FILE" >&2
			exit 1
		fi
		if [ -f "$DASHBOARD_WIDGETS_FILE" ]; then
			chown --no-dereference www-data:www-data "$DASHBOARD_WIDGETS_FILE"
			chmod 640 "$DASHBOARD_WIDGETS_FILE"
		fi
        chown root:www-data "$CONF_DIR/main.conf"
        chmod 660 "$CONF_DIR/main.conf"

        chmod +x /usr/bin/ups-pi-node-hotspot-fallback
        chmod +x /usr/bin/ups-pi-node-enable-buses
		ups-pi-node-enable-buses || true

        if [ -f /etc/nginx/sites-enabled/default ]; then
            rm -f /etc/nginx/sites-enabled/default
        fi
        ln -sf /etc/nginx/sites-available/ups-pi-node \
               /etc/nginx/sites-enabled/ups-pi-node

		deb-systemd-helper enable ups-pi-node-hotspot-fallback.timer >/dev/null || true
		deb-systemd-invoke stop ups-pi-node-helper-go-shadow.service >/dev/null || true
		deb-systemd-helper disable ups-pi-node-helper-go-shadow.service >/dev/null || true
		ups-pi-node-runtime --timeout 90s apply "$runtime_mode"
		deb-systemd-invoke restart ups-pi-node-hotspot-fallback.timer >/dev/null
        ;;
esac

exit 0
